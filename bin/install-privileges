#!/usr/bin/env bash
# Install the polkit grant that lets Colophon start/stop/restart
# ollama.service without a password. Run with sudo.
#
#   sudo bin/install-privileges           # install
#   bin/install-privileges --check        # probe with a no-op, no root needed
#   sudo bin/install-privileges --remove  # uninstall
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RULE_NAME="49-colophon-ollama.rules"
RULE_DEST="/etc/polkit-1/rules.d/$RULE_NAME"
UNIT="ollama.service"

check() {
  # NOT pkcheck. polkit refuses details from an unprivileged caller --
  # "Only trusted callers (e.g. uid 0 or an action owner) can use
  # CheckAuthorization() and pass details" -- and a detail-less query cannot
  # match a rule that scopes by unit and verb. Running it as root would ask
  # whether root is authorized, which is not the question. Verified 2026-08-10.
  #
  # So exercise the grant for real, with the verb that is a no-op for the
  # unit's current state: `stop` when already inactive, `start` when already
  # active. The polkit check runs in earnest; the unit's state does not move.
  if [[ ! -e "$RULE_DEST" ]]; then
    echo "grant MISSING: no $RULE_DEST -- run 'sudo $0'" >&2
    return 1
  fi
  if ! grep -q "subject.user !== \"$USER\"" "$RULE_DEST"; then
    echo "grant MISSING: $RULE_DEST is not interpolated for '$USER'" >&2
    echo "  installed for a different user? re-run 'sudo $0' as $USER" >&2
    return 1
  fi

  local state probe
  state="$(systemctl is-active "$UNIT" 2>/dev/null || true)"
  case "$state" in
    active)   probe=start ;;
    inactive) probe=stop ;;
    *)
      echo "grant installed for $USER, but $UNIT is '$state' -- not verified" >&2
      echo "  a no-op probe is only safe from active or inactive" >&2
      return 2
      ;;
  esac

  if systemctl --no-ask-password "$probe" "$UNIT" >/dev/null 2>&1; then
    echo "grant ok: $USER may start/stop/restart $UNIT without a password"
    echo "  probed with '$probe', a no-op while $UNIT is $state"
    return 0
  fi
  echo "grant MISSING: '$probe $UNIT' was refused -- polkit did not accept the rule" >&2
  return 1
}

case "${1:-install}" in
  --check) check; exit $? ;;
  --remove)
    [[ "$(id -u)" -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
    rm -f "$RULE_DEST"
    echo "removed $RULE_DEST"
    exit 0
    ;;
  install) ;;
  *) echo "usage: $0 [--check|--remove]" >&2; exit 2 ;;
esac

[[ "$(id -u)" -eq 0 ]] || { echo "must run as root: sudo $0" >&2; exit 1; }
# Without SUDO_USER this would interpolate "root" and grant nothing useful
# while appearing to succeed.
TARGET_USER="${SUDO_USER:-}"
[[ -n "$TARGET_USER" ]] || {
  echo "SUDO_USER is unset -- run this via sudo, not as a root login" >&2
  exit 1
}

install -d -m 0755 /etc/polkit-1/rules.d
sed "s/@USER@/$TARGET_USER/g" "$SRC/polkit/$RULE_NAME" > "$RULE_DEST"
chmod 0644 "$RULE_DEST"

echo "installed $RULE_DEST"
echo "  grants: $TARGET_USER may start/stop/restart ollama.service, and nothing else"
echo "  verify: bin/install-privileges --check"
