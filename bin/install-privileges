#!/usr/bin/env bash
# Install the polkit grant that lets Colophon start/stop/restart
# ollama.service without a password. Run with sudo.
#
#   sudo bin/install-privileges           # install
#   bin/install-privileges --check        # verify, no root needed
#   sudo bin/install-privileges --remove  # uninstall
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RULE_NAME="49-colophon-ollama.rules"
RULE_DEST="/etc/polkit-1/rules.d/$RULE_NAME"
ACTION="org.freedesktop.systemd1.manage-units"

check() {
  # pkcheck asks polkit the question without performing the action, so this
  # verifies the grant WITHOUT starting or stopping anything.
  #
  # The verb detail is required, not decorative: the rule scopes by verb, so a
  # query omitting it does not match and would report a correctly installed
  # grant as missing.
  if pkcheck --action-id "$ACTION" --detail unit ollama.service \
       --detail verb start --process $$ >/dev/null 2>&1; then
    echo "grant ok: $USER may manage ollama.service without a password"
    return 0
  fi
  echo "grant MISSING: run 'sudo $0' to install $RULE_DEST" >&2
  return 1
}

case "${1:-install}" in
  --check) check; exit $? ;;
  --remove)
    [[ "$(id -u)" -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
    rm -f "$RULE_DEST"
    echo "removed $RULE_DEST"
    exit 0
    ;;
  install) ;;
  *) echo "usage: $0 [--check|--remove]" >&2; exit 2 ;;
esac

[[ "$(id -u)" -eq 0 ]] || { echo "must run as root: sudo $0" >&2; exit 1; }
# Without SUDO_USER this would interpolate "root" and grant nothing useful
# while appearing to succeed.
TARGET_USER="${SUDO_USER:-}"
[[ -n "$TARGET_USER" ]] || {
  echo "SUDO_USER is unset -- run this via sudo, not as a root login" >&2
  exit 1
}

install -d -m 0755 /etc/polkit-1/rules.d
sed "s/@USER@/$TARGET_USER/g" "$SRC/polkit/$RULE_NAME" > "$RULE_DEST"
chmod 0644 "$RULE_DEST"

echo "installed $RULE_DEST"
echo "  grants: $TARGET_USER may start/stop/restart ollama.service, and nothing else"
echo "  verify: bin/install-privileges --check"
