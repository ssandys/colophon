#!/usr/bin/env bash
# Deploy the working tree into the Omarchy plugin directory under a separate
# dev identity, so it runs alongside the published plugin instead of fighting
# it. Users install the published plugin with `omarchy plugin add`; this script
# exists only for development.
set -euo pipefail

SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

manifest_id() {
  python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["id"])' "$1"
}

ID="$(manifest_id "$SRC/manifest.json")"
DEV_ID="$ID-dev"
DEST="$HOME/.config/omarchy/plugins/$DEV_ID"

mkdir -p "$DEST"
rsync -a --delete \
  --exclude '.git' --exclude 'tests' --exclude 'bin' --exclude 'docs' \
  --exclude 'polkit' --exclude '__pycache__' --exclude '.pytest_cache' \
  --exclude '.github' --exclude '.superpowers' --exclude '.gitignore' \
  --exclude 'README.md' --exclude 'AGENTS.md' --exclude 'CONTRIBUTING.md' \
  "$SRC/" "$DEST/"

# The registry keys plugins by manifest id, not by directory name, and one
# third-party plugin claiming another's id silently overwrites it in the map
# rather than warning. So the dev copy needs its own id -- rewritten here, in
# the deployed copy, to keep the source tree canonical and `git status` clean.
#
# Both substitutions tolerate already-rewritten input, so a run that finds
# stale output in $DEST cannot compound it into `-dev-dev`.
ID_RE="${ID//./\\.}"
# The name substitution anchors on the closing quote, not the opening one, so it
# catches the padded panel title ("  Colophon") as well as the bare literals.
REWRITE="s/$ID_RE\(-dev\)\?/$DEV_ID/g; s/Colophon\( (dev)\)\?\"/Colophon (dev)\"/g"
sed -i "$REWRITE" "$DEST/manifest.json" "$DEST/Panel.qml"

# A no-op sed would deploy a second plugin claiming the published id -- the
# exact silent collision this is here to avoid -- so prove the rewrite landed
# rather than trusting it.
deployed_id="$(manifest_id "$DEST/manifest.json")"
if [[ "$deployed_id" != "$DEV_ID" ]]; then
  echo "install: deployed manifest id is '$deployed_id', expected '$DEV_ID'" >&2
  exit 1
fi
if ! grep -q "ipcTarget: \"$DEV_ID\"" "$DEST/Panel.qml"; then
  echo "install: Panel.qml ipcTarget was not rewritten to '$DEV_ID'" >&2
  exit 1
fi

echo "installed -> $DEST"
echo "  id: $DEV_ID   toggle: omarchy-shell shell toggle $DEV_ID"
