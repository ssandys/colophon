// Colophon: allow one user to start, stop, and restart exactly one unit
// without a password. Installed by bin/install-privileges.
//
// Scoped three ways -- user, unit, AND verb. systemd passes both a `unit` and a
// `verb` detail with manage-units, and scoping by unit alone would grant every
// per-unit D-Bus operation on it, not just the lifecycle verbs: kill (an
// arbitrary signal to every process in the unit's cgroup), set-property,
// reset-failed, freeze/thaw, and clean. The verb allow-list is what makes the
// grant match its description.
//
// enable/disable are absent deliberately: they go through manage-unit-files,
// which systemd invokes with NO unit detail, so no rule can scope that action
// to a single unit. See the design spec's phase-2 section.
polkit.addRule(function (action, subject) {
  if (subject.user !== "@USER@") return;
  if (action.id !== "org.freedesktop.systemd1.manage-units") return;
  if (action.lookup("unit") !== "ollama.service") return;
  var verb = action.lookup("verb");
  if (verb === "start" || verb === "stop" || verb === "restart") {
    return polkit.Result.YES;
  }
});
